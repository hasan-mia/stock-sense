# Local API server
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stock_sense
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_SSL=false

# Authentication and browser access
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001

# Seed accounts (local development only)
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-local-only-password
STAFF_SEED_PASSWORD=

# Optional forecast explanations (Redis and Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CACHE_TTL_SECONDS=900
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Forecast defaults
FORECAST_DEFAULT_DAYS=30
FORECAST_HISTORY_DAYS=60
FORECAST_LEAD_TIME_DAYS=7
FORECAST_REVIEW_PERIOD_DAYS=7
