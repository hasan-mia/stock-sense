# Database
DB_DATABASE=stocksense
DB_USERNAME=stocksense
DB_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

# API
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# Browser-visible API origin (set this to the deployed API URL before building)
NEXT_PUBLIC_API_URL=http://localhost:3000
UI_PORT=3001

# Optional AI restock suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CACHE_TTL_SECONDS=900
GEMINI_TIMEOUT_MS=15000
